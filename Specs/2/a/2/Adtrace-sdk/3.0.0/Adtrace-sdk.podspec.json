{
  "name": "Adtrace-sdk",
  "version": "3.0.0",
  "summary": "This is the iOS SDK of adtrace. You can read more about it at https://adtrace.io.",
  "homepage": "https://github.com/adtrace/adtrace_sdk_iOS",
  "license": {
    "type": "MIT",
    "file": "MIT-LICENSE"
  },
  "authors": {
    "Nasser Amini": "namini40@gmail.com"
  },
  "source": {
    "git": "https://github.com/adtrace/adtrace_sdk_iOS.git",
    "tag": "v3.0.0"
  },
  "platforms": {
    "ios": "12.0",
    "tvos": "12.0"
  },
  "frameworks": "SystemConfiguration",
  "ios": {
    "weak_frameworks": "AdSupport"
  },
  "tvos": {
    "weak_frameworks": "AdSupport"
  },
  "requires_arc": true,
  "default_subspecs": "Core",
  "subspecs": [
    {
      "name": "Core",
      "source_files": [
        "Adtrace/*.{h,m}",
        "Adtrace/ADTAdditions/*.{h,m}"
      ],
      "exclude_files": "Adtrace/include/**/*.h",
      "resource_bundles": {
        "Adtrace": [
          "Adtrace/PrivacyInfo.xcprivacy"
        ]
      }
    }
  ]
}
