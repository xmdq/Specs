{
  "name": "AppMetricaCrashes",
  "version": "7.0.0",
  "summary": "Provides essential utilities for efficient crash and error handling and reporting",
  "homepage": "https://appmetrica.io",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "AppMetrica": "admin@appmetrica.io"
  },
  "source": {
    "git": "https://github.com/appmetrica/appmetrica-sdk-ios.git",
    "tag": "7.0.0"
  },
  "platforms": {
    "ios": "15.0",
    "tvos": "15.0"
  },
  "swift_versions": [
    "5.9",
    "6.0"
  ],
  "pod_target_xcconfig": {
    "DEFINES_MODULE": "YES"
  },
  "frameworks": "Foundation",
  "dependencies": {
    "AppMetricaCore": [
      "= 7.0.0"
    ],
    "AppMetricaCoreExtension": [
      "= 7.0.0"
    ],
    "AppMetricaCoreUtils": [
      "= 7.0.0"
    ],
    "AppMetricaHostState": [
      "= 7.0.0"
    ],
    "AppMetricaProtobufUtils": [
      "= 7.0.0"
    ],
    "AppMetricaLog": [
      "= 7.0.0"
    ],
    "AppMetricaPlatform": [
      "= 7.0.0"
    ],
    "AppMetricaStorageUtils": [
      "= 7.0.0"
    ],
    "AppMetricaEncodingUtils": [
      "= 7.0.0"
    ],
    "AppMetricaProtobuf": [
      "= 7.0.0"
    ],
    "KSCrash/Recording": [
      ">= 2.5.1",
      "< 2.6.0"
    ]
  },
  "header_dir": "AppMetricaCrashes",
  "source_files": "AppMetricaCrashes/Sources/**/*.{h,m,mm,c}",
  "public_header_files": "AppMetricaCrashes/Sources/include/**/*.h",
  "preserve_paths": "AppMetricaCrashes/helper",
  "resource_bundles": {
    "AppMetricaCrashes": "AppMetricaCrashes/Sources/Resources/PrivacyInfo.xcprivacy"
  },
  "swift_version": "6.0"
}
